    "rule_name": "Directory Replication Rights Exercised by Non-DC Principal",
    "severity": "critical",
    "analyst_priority": "P1",
    "description": "A security principal that is not a domain controller invoked the directory replication service (DRSUAPI DsGetNCChanges) against the domain naming context. Replication rights allow an account to request the password hash of any principal in the domain, including krbtgt, without ever touching a domain controller's disk or memory.",
    "detection_logic": "Security EventID=4662 WHERE ObjectType = '{19195a5b-6da0-11d0-afd3-00c04fd930c9}' (domainDNS) AND Properties CONTAINS ANY ('{1131f6aa-9c07-11d1-f79f-00c04fc2dcd2}' /* DS-Replication-Get-Changes */, '{1131f6ad-9c07-11d1-f79f-00c04fc2dcd2}' /* DS-Replication-Get-Changes-All */) AND SubjectUserName NOT IN (domain_controller_computer_accounts) AND SubjectUserName NOT IN (approved_replication_service_accounts)",
