    "rule_id": "TNX-EXEC-001",
    "rule_name": "MSBuild Executed a Project File From a Non-Development Path",
    "severity": "high",
    "analyst_priority": "P2",
    "description": "MSBuild.exe executed a project file located outside any recognised source-code or build-agent path. MSBuild is a signed Microsoft binary that will compile and run arbitrary C# supplied inline in a project file, so it is used to execute code on hosts where unsigned binaries would be blocked or noticed.",
    "detection_logic": "Sysmon EventID=1 (ProcessCreate) WHERE Image ENDSWITH '\\MSBuild.exe' AND CommandLine MATCHES '\\.(xml|csproj|proj|targets)' AND CommandLine NOT MATCHES ANY (source_root_paths, build_agent_paths, '\\\\Program Files')",
